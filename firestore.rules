rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // places/{placeId}/members/{uid} 기준: manager / submanager / member 중 매니저·부매니저만
    // (서버에서 role이 'subManager'로 저장되는 경우도 허용)
    function isPlaceManager(placeId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid)).data.role in ['manager', 'submanager', 'subManager'];
    }

    // 플레이스 소유자: place.adminId == request.auth.uid (place 생성 시 설정)
    function isPlaceOwner(placeId) {
      return signedIn() &&
        get(/databases/$(database)/documents/places/$(placeId)).data.adminId == request.auth.uid;
    }

    // 매니저만 (부매니저 제외) — 플레이스 문서 수정/삭제용
    function isPlaceManagerOnly(placeId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid)).data.role == 'manager';
    }

    // 코스 쓰기: 소유자, 또는 매니저(전체), 또는 부매니저(manageableCourseIds에 해당 코스만)
    // exists()를 먼저 검사해야 비멤버일 때 get() 호출로 인한 permission-denied 방지
    function canWriteCourse(placeId, courseId) {
      let memberPath = /databases/$(database)/documents/places/$(placeId)/members/$(request.auth.uid);
      return isPlaceOwner(placeId) || (signedIn() &&
        exists(memberPath) &&
        (get(memberPath).data.role == 'manager' ||
         (get(memberPath).data.role in ['submanager', 'subManager'] &&
          courseId in get(memberPath).data.get('manageableCourseIds', []))));
    }

    // 기본: 전부 거부
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== Users ====================
    // 로그인/가입 플로우에서 phoneNumber로 조회가 필요해서 read는 signedIn이면 허용.
    // (추후: users 공개 범위 축소 + uid 기반 조회로 리팩토링 추천)
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && request.auth.uid == userId;

      // FCM 토큰 저장: 본인만 쓰기 (푸시 알림 수신용)
      match /fcmTokens/{tokenId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      // 알림 서브컬렉션 (users/{userId}/notifications)
      match /notifications/{notificationId} {
        allow read, update, delete: if signedIn() && request.auth.uid == userId;
        allow create: if false;
      }
    }

    // ==================== Admin Users (미사용 — manager/submanager만 사용) ====================
    match /adminUsers/{adminId} {
      allow read, write: if false;
    }

    // ==================== Places ====================
    // 컬렉션 레벨 쿼리 허용 (로그인 없이도 가능)
    match /places/{placeId} {
      // 읽기: 로그인 없이도 모든 사용자가 읽기 가능 (Apple App Store 가이드라인 준수)
      allow read: if true;
      // place 생성: 로그인 사용자가 자신을 adminId로 설정해 생성 (생성 후 members에 manager로 추가는 앱/서버에서)
      allow create: if signedIn() && request.resource.data.adminId == request.auth.uid;
      // place 수정/삭제: 소유자 또는 매니저만 (부매니저는 플레이스 문서 수정 불가)
      allow update, delete: if isPlaceOwner(placeId) || isPlaceManagerOnly(placeId);

      // ==================== Places 서브컬렉션: Members ====================
      // places/{placeId}/members/{uid} — 매니저·부매니저·일반멤버 통일
      // create: 소유자(플레이스 생성 직후 첫 멤버 추가) 또는 기존 매니저만
      match /members/{memberId} {
        allow read: if signedIn() && (
          memberId == request.auth.uid ||
          isPlaceManager(placeId) ||
          isPlaceOwner(placeId)
        );
        allow create, update, delete: if signedIn() && (isPlaceManager(placeId) || isPlaceOwner(placeId));
      }

      // ==================== Places 서브컬렉션: Pending Members (초대 토큰) ====================
      // places/{placeId}/pendingMembers/{inviteId} — 초대된 상태, 가입 전 임시
      match /pendingMembers/{inviteId} {
        allow read: if signedIn() && (
          isPlaceManager(placeId) ||
          (hasUserDoc() && resource.data.phoneNumber == userDoc().data.phoneNumber)
        );
        allow create, update, delete: if signedIn() && isPlaceManager(placeId);
      }

      // ==================== Places 서브컬렉션: Courses ====================
      match /courses/{courseId} {
        allow read: if true;
        allow create, update, delete: if canWriteCourse(placeId, courseId);
      }

      // ==================== Places 서브컬렉션: Stories ====================
      match /stories/{storyId} {
        allow read: if true;
        allow create, update, delete: if isPlaceManager(placeId);
      }

    }

    // ==================== Members Collection Group ====================
    // collectionGroup('members').where('userId','==',uid) 쿼리용
    // 쿼리 필터(userId)와 규칙 조건 일치 필요
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && (
        memberId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // ==================== Pending Members Collection Group ====================
    // collectionGroup('pendingMembers').where('phoneNumber','==', normalized) 쿼리용.
    // 규칙은 쿼리 파라미터(normalized)를 볼 수 없으므로, "반환 가능한 문서"만 허용하도록
    // 문서 단위 조건(본인 전화번호 일치)으로 허용. create/update/delete는
    // places/{placeId}/pendingMembers 규칙이 담당.
    match /{path=**}/pendingMembers/{pendingId} {
      allow read: if signedIn() && (
        hasUserDoc() && resource.data.phoneNumber == userDoc().data.phoneNumber
      );
      allow create, update, delete: if false;
    }

    // ==================== Reservation Summary (세션별 예약 수 집계, N/M 표시용) ====================
    // 로그인 사용자 읽기 가능 (PII 없음, reservedCount/capacity만)
    match /reservationSummary/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // ==================== Reservations (top-level, placeId 필드 포함) ====================
    // 실제 구현: reservations/{id} (Flutter/Functions 모두 top-level 사용)
    match /reservations/{reservationId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.placeId != null && isPlaceManager(resource.data.placeId))
      );
      allow create, update, delete: if false;
    }

    // ==================== Enrollments ====================
    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.placeId != null && (isPlaceManager(resource.data.placeId) || isPlaceOwner(resource.data.placeId)))
      );
      // create 시에는 resource 없음 → request.resource만 사용
      allow create: if request.resource.data.placeId != null &&
        (isPlaceManager(request.resource.data.placeId) || isPlaceOwner(request.resource.data.placeId));
      // update, delete 시에는 기존 문서 resource 사용
      allow update, delete: if resource.data.placeId != null &&
        (isPlaceManager(resource.data.placeId) || isPlaceOwner(resource.data.placeId));
    }

    // ==================== Enrollments Subcollections: actionHistory ====================
    // read: 본인 수강(enrollment.userId == uid) 또는 플레이스 매니저
    // create/update/delete: 플레이스 매니저만
    match /enrollments/{enrollmentId}/actionHistory/{actionId} {
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(enrollmentId)) &&
        (
          get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.userId == request.auth.uid ||
          (get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.placeId != null &&
            isPlaceManager(get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.placeId))
        );
      allow create, update, delete: if
        get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.placeId != null &&
        isPlaceManager(get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.placeId);
    }

    // ==================== Course Policies ====================
    // 부매니저는 manageableCourseIds에 해당하는 코스의 정책만 수정 가능
    match /coursePolicies/{courseId} {
      allow read: if true;
      allow create: if request.resource.data.placeId != null && canWriteCourse(request.resource.data.placeId, courseId);
      allow update, delete: if (resource.data.placeId != null && canWriteCourse(resource.data.placeId, courseId)) ||
        (request.resource.data.placeId != null && canWriteCourse(request.resource.data.placeId, courseId));
    }

    // ==================== Booking Week Opens (매니저 "미리 예약 열기") ====================
    match /bookingWeekOpens/{docId} {
      allow read: if true;
      allow create, update, delete: if (resource.data.placeId != null && isPlaceManager(resource.data.placeId)) ||
        (request.resource.data.placeId != null && isPlaceManager(request.resource.data.placeId));
    }

    // ==================== Course Members (매니저만: placeId 있으면 해당 플레이스 매니저) ====================
    match /courseMembers/{docId} {
      allow read, create, update, delete: if (resource.data.placeId != null && isPlaceManager(resource.data.placeId)) ||
        (request.resource.data.placeId != null && isPlaceManager(request.resource.data.placeId));
    }

    // ==================== Pending Members (top-level, 미사용 권장 — 서브컬렉션으로만 사용) ====================
    match /pendingMembers/{pendingId} {
      allow read: if signedIn() && hasUserDoc() && resource.data.phoneNumber == userDoc().data.phoneNumber;
      allow create, update, delete: if false;
    }

    // ==================== Content ====================
    match /promotions/{promotionId} {
      allow read: if true;
      allow create, update, delete: if (resource.data.placeId != null && isPlaceManager(resource.data.placeId)) ||
        (request.resource.data.placeId != null && isPlaceManager(request.resource.data.placeId));
    }

    // ==================== Course Overrides (비정기 일정) ====================
    // 부매니저: manageableCourseIds에 해당하는 코스의 오버라이드만 쓰기 가능
    match /courseOverrides/{overrideId} {
      allow read: if true;
      allow create: if request.resource.data.placeId != null && request.resource.data.courseId != null &&
        canWriteCourse(request.resource.data.placeId, request.resource.data.courseId);
      allow update, delete: if resource.data.placeId != null && resource.data.courseId != null &&
        canWriteCourse(resource.data.placeId, resource.data.courseId);
    }
  }
}


