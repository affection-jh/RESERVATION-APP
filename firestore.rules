rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function adminUserDoc() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function hasUserDoc() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminUserDoc() {
      return signedIn() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function placeDoc(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId));
    }

    // ✅ 관리자 판별 (개선된 구조)
    //
    // - users/{request.auth.uid} 문서의 `adminForPlaces` 배열로 관리자 여부 판별
    // - 한 유저가 관리자도 되고 일반 유저도 될 수 있음
    function isAdmin() {
      // users.adminForPlaces 기반 (신규 구조) 또는 adminUsers 문서 존재(레거시/관리자 온보딩)
      return (hasUserDoc() &&
        userDoc().data.adminForPlaces != null &&
        userDoc().data.adminForPlaces.size() > 0)
        || hasAdminUserDoc();
    }

    function isAdminForPlace(placeId) {
      // users.adminForPlaces 또는 adminUsers.placeIds 둘 중 하나로 관리자 권한 판별
      return (hasUserDoc() &&
        userDoc().data.adminForPlaces != null &&
        placeId in userDoc().data.adminForPlaces)
        || (hasAdminUserDoc() &&
          adminUserDoc().data.placeIds != null &&
          placeId in adminUserDoc().data.placeIds);
    }

    // 기본: 전부 거부
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== Users ====================
    // 로그인/가입 플로우에서 phoneNumber로 조회가 필요해서 read는 signedIn이면 허용.
    // (추후: users 공개 범위 축소 + uid 기반 조회로 리팩토링 추천)
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    // ==================== Admin Users ====================
    // 클라이언트에서 adminUsers를 직접 만들거나 수정하는 건 권장하지 않음(권한 상승 위험).
    // 운영에서는 콘솔/서버에서만 관리 권장.
    // phoneNumber로 쿼리할 수 있도록 허용 (자동 로그인 등에서 필요)
    // - 직접 문서 읽기: 자신의 문서만 (adminId == request.auth.uid)
    // - 쿼리: phoneNumber로 조회 시 결과 문서의 userId가 request.auth.uid와 일치하거나,
    //         현재 사용자의 전화번호와 일치하는 경우 허용
    match /adminUsers/{adminId} {
      // 직접 문서 읽기: 자신의 문서만
      // 쿼리: phoneNumber로 조회 시 다음 중 하나를 만족해야 함:
      // 1. 결과 문서의 userId가 request.auth.uid와 일치
      // 2. 결과 문서의 phoneNumber가 현재 사용자의 전화번호와 일치 (users 컬렉션에서 확인)
      allow read: if signedIn() && (
        request.auth.uid == adminId ||
        resource.data.userId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          resource.data.phoneNumber == userDoc().data.phoneNumber
        )
      );
      // create는 서버(Callable Function)만
      allow create, delete: if false;

      // update는 본인 문서에 대해서만, 안전한 필드만 허용
      allow update: if signedIn()
        && request.auth.uid == adminId
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        // 전화번호는 변경 불가
        && request.resource.data.phoneNumber == resource.data.phoneNumber
        // PIN(authPin) 변경은 클라이언트에서 금지 (서버에서만)
        && request.resource.data.authPin == resource.data.authPin
        // 변경 가능한 필드만
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name',
          'email',
          'placeIds',
          'lastAccessedPlaceId',
          'notificationsEnabled',
          'updatedAt'
        ]);
    }

    // ==================== Places ====================
    match /places/{placeId} {
      // 읽기: 로그인한 사용자는 모두 읽기 가능 (개발 단계)
      // 주의: adminUsers 문서 ID가 Firebase Auth UID와 다를 수 있으므로,
      // Firestore 규칙에서 직접 확인하기 어려움
      // 프로덕션에서는 Cloud Function을 통해 권한 확인 권장
      allow read: if signedIn();
      // place 생성: adminUsers 문서가 있는 관리자는 자신의 adminId로 place 생성 가능
      allow create: if signedIn() &&
        request.resource.data.adminId == request.auth.uid &&
        hasAdminUserDoc();
      // place 수정/삭제: 해당 place를 관리하는 관리자만 가능
      allow update, delete: if isAdminForPlace(placeId);
      
      // ==================== Places 서브컬렉션: Reservations ====================
      // places/{placeId}/reservations 서브컬렉션
      match /reservations/{reservationId} {
        // 읽기: 자신의 예약이거나 해당 플레이스 관리자
        allow read: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          isAdminForPlace(placeId)
        );
        // 생성/수정/삭제: Functions만 가능
        allow create, update, delete: if false;
      }
    }

    // ==================== Session Reservations (Functions Only) ====================
    match /sessionReservations/{docId} {
      allow read: if signedIn() && (
        // 일반 사용자: 자신의 placeIds에 포함된 경우
        (hasUserDoc() &&
          userDoc().data.placeIds != null &&
          resource.data.placeId != null &&
          resource.data.placeId in userDoc().data.placeIds)
        ||
        // 관리자: 모든 sessionReservations 읽기 가능
        // (placeId 필터는 쿼리에서 처리되므로, 관리자는 모든 문서 읽기 허용)
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ==================== Enrollments ====================
    match /enrollments/{enrollmentId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // 관리자는 크레딧/기간 연장 등 직접 수정 가능
      // (예약 트랜잭션에서 remainingReservations 변경은 Functions의 Admin SDK가 수행)
      allow create, update, delete: if isAdmin();
    }

    // ==================== Enrollments Subcollections (Admin Only) ====================
    // 히스토리/관리자액션/연장요청은 서브컬렉션으로 분리되어 있으며,
    // 기본 규칙(match /{document=**})에 의해 별도 match가 없으면 전부 거부됨.
    // 관리자 화면에서 쓰기/읽기가 필요하므로 명시적으로 허용.
    match /enrollments/{enrollmentId}/reenrollmentHistory/{recordId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /enrollments/{enrollmentId}/adminActions/{actionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /enrollments/{enrollmentId}/extensionRequests/{requestId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ==================== Course Policies ====================
    match /coursePolicies/{courseId} {
      // 유저도 정책을 읽어야 잠금(openAt) 표시 가능
      allow read: if signedIn();
      // 정책은 place 단위로 관리되므로, 해당 place를 관리하는 관리자만 수정 가능
      allow create: if isAdmin() &&
        request.resource.data.placeId != null &&
        isAdminForPlace(request.resource.data.placeId);
      allow update, delete: if isAdmin() && (
        (resource.data.placeId != null && isAdminForPlace(resource.data.placeId)) ||
        (request.resource.data.placeId != null &&
          isAdminForPlace(request.resource.data.placeId))
      );
    }

    // ==================== Capacity Overrides ====================
    match /dateCapacityOverrides/{overrideId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ==================== Course Members ====================
    match /courseMembers/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ==================== Pending Members (관리자가 미리 등록한 멤버) ====================
    // 관리자가 전화번호로 멤버를 미리 등록하고, 사용자 로그인 시 자동 매칭
    match /pendingMembers/{pendingId} {
      // 읽기: 관리자 또는 자신의 전화번호와 일치하는 문서만
      // (phoneNumber로 쿼리 시 결과 문서의 phoneNumber가 users 컬렉션의 전화번호와 일치해야 함)
      allow read: if signedIn() && (
        isAdmin() ||
        (hasUserDoc() &&
          resource.data.phoneNumber == userDoc().data.phoneNumber)
      );
      // 생성/수정/삭제: 관리자만
      allow create, update, delete: if isAdmin();
    }

    // ==================== Place Memberships (가입 요청) ====================
    match /placeMemberships/{membershipId} {
      // 읽기: 본인 멤버십 또는 관리자
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // 생성:
      // - 유저 본인이 가입 요청 생성
      // - 또는 관리자가 "자신이 관리하는 플레이스"에 대해 멤버십을 생성(초대/승인 플로우)
      //   (MemberService가 고정 docId: `${userId}_${placeId}` 로 생성하므로, 이를 강제해서 권한 상승을 막는다)
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        (
          request.resource.data.placeId != null &&
          isAdminForPlace(request.resource.data.placeId) &&
          membershipId == request.resource.data.userId + '_' + request.resource.data.placeId &&
          // invitedBy가 있다면 "현재 관리자"여야 함 (없으면 통과)
          (!('invitedBy' in request.resource.data) || request.resource.data.invitedBy == request.auth.uid)
        )
      );
      // 업데이트/삭제: 본인 또는 관리자 (정책적으로 더 엄격히 하고 싶으면 추후 분리)
      allow update, delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // ==================== Content ====================
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // 알림 생성은 서버/관리자에서만
      allow create, delete: if isAdmin();
      // 읽음 처리만 유저가 가능
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}


